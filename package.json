{
  "name": "uclient",
  "version": "1.0.6-beta",
  "description": "Minecraft Launcher",
  "license": "GPL-3.0-only",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && esbuild --bundle dist/renderer/app.js --outfile=src/renderer/app.js --format=iife --global-name=app --platform=browser && esbuild --bundle dist/renderer/console.js --outfile=src/renderer/console.js --format=iife --global-name=consoleWin --platform=browser",
    "build:world": "node scripts/copy-world-assets.mjs && node scripts/build-world.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:pack-only": "electron-builder --win --dir"
  },
  "build": {
    "appId": "undefined-client",
    "productName": "Undefined Client",
    "directories": {
      "output": "dist-windows"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "files": [
      "package.json",
      "dist/main/**/*.js",
      "dist/preload/**/*.js",
      "dist/renderer/**/*.js",
      "dist/shared/**/*.js",
      "src/renderer/**/*",
      "!src/renderer/**/*.{ts,tsx,map}",
      "assets/**/*",
      "!assets/MusicForUClient{,/**}",
      "!assets/screenshots{,/**}",
      "IconForBuild/icon.ico",
      "!**/*.{map,md,markdown}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,README,readme}",
      "!**/node_modules/*/{test,tests,__tests__,docs,doc,example,examples,bench,benchmark}",
      "!**/node_modules/**/{src,Source}/**",
      "node_modules/protodef/src/**",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.ts",
      "!node_modules/minecraft-data{,/**}",
      "!node_modules/minecraft-renderer{,/**}",
      "!node_modules/mc-assets{,/**}",
      "!node_modules/contro-max{,/**}",
      "!node_modules/prismarine-chunk{,/**}",
      "!node_modules/three/examples{,/**}",
      "!node_modules/three/build/three.module.js",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/build/three.webgpu.js",
      "!node_modules/three/build/three.webgpu.nodes.js",
      "!node_modules/three/build/three.core.js"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "protocols": [
      {
        "name": "Undefined Client",
        "schemes": [
          "uclient"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "IconForBuild/icon.ico",
      "executableName": "uclient"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "IconForBuild/icon.ico",
      "uninstallerIcon": "IconForBuild/icon.ico"
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/three": "^0.185.1",
    "buffer": "6.0.3",
    "contro-max": "0.1.12",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "mc-assets": "0.2.83",
    "minecraft-data": "3.112.0",
    "minecraft-renderer": "0.1.96",
    "prismarine-chunk": "1.41.0",
    "process": "0.11.10",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "discord-rpc": "^4.0.1",
    "eml-lib": "^2.6.0",
    "marked": "^18.0.7",
    "minecraft-server-util": "^5.4.4",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "skinviewengine": "file:skinviewengine"
  }
}
