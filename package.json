{
  "name": "uclient",
  "version": "1.0.8-beta",
  "description": "Powerfull Minecraft client with support Mods, AI, Social and more",
  "homepage": "https://uprojects.site/client",
  "license": "GPL-3.0-only",
  "author": "Undefined Studio <vovaberezin2200@gmail.com>",
  "main": "dist/main/main.js",
  "scripts": {
    "build:skinviewengine": "npm install --prefix skinviewengine && npm run build --prefix skinviewengine",
    "build:uclient": "tsc && node scripts/bundle-renderer.mjs",
    "build": "npm run build:skinviewengine && npm run build:uclient",
    "postinstall": "npm run build:skinviewengine",
    "build:world": "node scripts/copy-world-assets.mjs && node scripts/build-world.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:linux:deb": "npm run build && electron-builder --linux deb",
    "dist:linux:rpm": "npm run build && electron-builder --linux rpm",
    "dist:linux:tar": "npm run build && electron-builder --linux tar.gz",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:pack-only": "electron-builder --dir",
    "dist:linux:snap": "npm run build && electron-builder --linux snap",
    "dist:linux:flatpak": "npm run build && electron-builder --linux flatpak",
    "dist:linux:pacman": "npm run build && electron-builder --linux pacman",
    "dist:linux:all": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "org.studioberry.uclient",
    "productName": "Undefined Client",
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "files": [
      "package.json",
      "dist/main/**/*.js",
      "dist/preload/**/*.js",
      "dist/renderer/**/*.js",
      "dist/shared/**/*.js",
      "src/renderer/**/*",
      "!src/renderer/**/*.{ts,tsx,map}",
      "assets/**/*",
      "!assets/MusicForUClient{,/**}",
      "!assets/screenshots{,/**}",
      "IconForBuild/icon.ico",
      "IconForBuild/512.png",
      "!**/*.{map,md,markdown}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,README,readme}",
      "!**/node_modules/*/{test,tests,__tests__,docs,doc,example,examples,bench,benchmark}",
      "!**/node_modules/**/{src,Source}/**",
      "node_modules/protodef/src/**",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.ts",
      "!node_modules/minecraft-data{,/**}",
      "!node_modules/minecraft-renderer{,/**}",
      "!node_modules/mc-assets{,/**}",
      "!node_modules/contro-max{,/**}",
      "!node_modules/prismarine-chunk{,/**}",
      "!node_modules/three/examples{,/**}",
      "!node_modules/three/build/three.module.js",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/build/three.webgpu.js",
      "!node_modules/three/build/three.webgpu.nodes.js",
      "!node_modules/three/build/three.core.js"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "protocols": [
      {
        "name": "Undefined Client",
        "schemes": [
          "uclient"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "IconForBuild/icon.ico",
      "executableName": "uclient"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "IconForBuild/icon.ico",
      "uninstallerIcon": "IconForBuild/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "deb",
        "snap",
        "flatpak",
        "pacman",
        "rpm"
      ],
      "maintainer": "Undefined Studio <vovaberezin2200@gmail.com>",
      "icon": "IconForBuild/512.png",
      "executableName": "uclient",
      "category": "Game",
      "synopsis": "This is Undefined Client",
      "description": "Undefined Client is an open source launcher with a mod catalog, instances, and UAgent: the AI helps find mods, fix crashes, and manage builds — all in one app.",
      "mimeTypes": [
        "x-scheme-handler/uclient"
      ]
    },
    "deb": {
      "depends": [
        "libdecor-0-0"
      ]
    },
    "rpm": {
      "depends": [
        "libdecor"
      ]
    },
    "pacman": {
      "depends": [
        "libdecor"
      ]
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "baseVersion": "23.08"
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/three": "^0.185.1",
    "buffer": "6.0.3",
    "contro-max": "0.1.12",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "mc-assets": "0.2.83",
    "minecraft-data": "3.112.0",
    "minecraft-renderer": "0.1.96",
    "prismarine-chunk": "1.41.0",
    "process": "0.11.10",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "discord-rpc": "^4.0.1",
    "eml-lib": "^2.7.3",
    "lottie-web": "^5.12.2",
    "marked": "^18.0.7",
    "minecraft-server-util": "^5.4.4",
    "prismarine-nbt": "^2.8.0",
    "skinviewengine": "file:skinviewengine",
    "uisfx": "^0.4.0"
  }
}
