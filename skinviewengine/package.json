{
  "name": "skinviewengine",
  "version": "0.2.0",
  "description": "Three.js-движок рендеринга Minecraft-скинов на базе skin3d с улучшенной графикой",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc",
    "preview": "vite preview"
  },
  "dependencies": {
    "skin3d": "^0.1.3",
    "skinview-utils": "^0.7.1",
    "three": "^0.156.1"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  }
}
